{
  "name": "richterakademie",
  "productName": "Richterakademie",
  "version": "1.3.0",
  "description": "Lern- und Verhandlungs-App für Richter am DOJ Corleone City",
  "main": "main.js",
  "author": "Timo Hinners",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Timo-Hinners/richterakademie.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "predist": "npm install --no-save --force sherpa-onnx-win-x64@1.13.8"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "sherpa-onnx-node": "1.13.8",
    "tar-stream": "^3.1.7",
    "unbzip2-stream": "^1.4.3"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.0.20"
  },
  "build": {
    "appId": "ch.timohinners.richterakademie",
    "productName": "Richterakademie",
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "asr.js",
      "asr-worker.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "!**/node_modules/sherpa-onnx-linux-*/**",
      "!**/node_modules/sherpa-onnx-darwin-*/**",
      "!**/node_modules/sherpa-onnx-win-ia32/**",
      "!**/node_modules/**/*.md",
      "!**/node_modules/**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sherpa-onnx-*/**",
      "assets/models/**"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Richterakademie",
      "runAfterFinish": true,
      "artifactName": "Richterakademie-Setup-${version}.exe",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "differentialPackage": true
    },
    "compression": "maximum",
    "publish": [
      {
        "provider": "github",
        "owner": "Timo-Hinners",
        "repo": "richterakademie",
        "releaseType": "release"
      }
    ]
  }
}